{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quizgen quiz file",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "language": { "type": "string", "minLength": 1 },
    "questions_per_quiz": { "type": "integer", "minimum": 1 },
    "feedback": { "enum": ["immediate", "end"] },
    "shuffle_options": { "type": "boolean" },
    "ui": { "type": "object" },
    "author": { "$ref": "#/$defs/author" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "text": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      ]
    },
    "imageRef": { "type": "string" },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "options"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "image": { "$ref": "#/$defs/imageRef" },
        "image_alt": { "$ref": "#/$defs/text" },
        "explanation": { "$ref": "#/$defs/text" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "image": { "$ref": "#/$defs/imageRef" },
        "image_alt": { "$ref": "#/$defs/text" },
        "correct": { "type": "boolean" }
      }
    }
  }
}
