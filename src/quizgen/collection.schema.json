{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quizgen collection file",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "ui": { "type": "object" },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "email": { "type": "string" }
      }
    }
  }
}
